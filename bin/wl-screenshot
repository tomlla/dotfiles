#!/usr/bin/env bash

mode=${1:-"--crop"} # --crop | --full

type -p grim
type -p ksnip

set -xe
dir=~/Pictures/screenshots
mkdir -p $dir

timestamp=$(date '+%Y%m%d-%H_%M_%S')
image_file=${dir}/${timestamp}.png

case "$mode" in
    "--full")
        grim $image_file
        ;;
    *)
        grim -g "$(slurp)" $image_file
esac

ksnip $image_file

