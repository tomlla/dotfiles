# GTK_IM_MODULE は設定しない:
# wlroots系(labwc)ではtext-input-v3経由にして候補windowの配置をcompositorに任せる。
# QT_IM_MODULE は必要: Qt5(VLC等)はtext-input-v3非対応でD-Busモジュール経由でないとIMEが効かない。
# XMODIFIERS は Xwayland アプリ用。
QT_IM_MODULE=fcitx5
XMODIFIERS=@im=fcitx5

# https://github.com/flameshot-org/flameshot/blob/master/docs/Sway%20and%20wlroots%20support.md
# sway: flameshot 用。
# labwc: xdg-desktop-portal が labwc-portals.conf (default=wlr) を選び、
# screencast を wlr backend に振るため
XDG_CURRENT_DESKTOP=sway:labwc

# === This will be used from i3-sensible-terminal ===
TERMINAL=alacritty
TERMINAL=ghostty

XCURSOR_SIZE=32

# Map Caps Lock to Ctrl
XKB_DEFAULT_OPTIONS=caps:ctrl_modifier

PATH=$PATH:/home/nt/.dotfiles/bin

