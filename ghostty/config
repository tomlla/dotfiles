window-width = 100
window-height = 30

window-decoration = server

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

keybind = ctrl+m=text:\n

# # https://ghostty.org/docs/config/reference#keybind
keybind = ctrl+enter=unbind
keybind = f11=toggle_fullscreen

# font-style = "Noto Sans Mono"
font-family = "Noto Sans Mono"
font-family = "Noto Sans CJK JP"
font-family = "Karma"
font-family = "Noto Sans Devanagari UI"

# font-style = "CommitMono Nerd Font"

font-size = 16

# https://ghostty.org/docs/config/reference#font-feature
# * -calt: disable Ligature
# font-feature = "-calt"
#
# disable Disable discretionary ligatures
# font-feature = -dlig

# theme = iTerm2 Solarized Light
# theme = dark:Catppuccin Frappe,light:iTerm2 Solarized Light
theme = dark:Catppuccin Frappe,light:Apple System Colors Light


